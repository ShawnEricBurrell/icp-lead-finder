{
  "name": "CRMSyncHistory",
  "type": "object",
  "properties": {
    "connection_id": {
      "type": "string",
      "description": "ID of the CRM connection"
    },
    "crm_type": {
      "type": "string",
      "enum": [
        "hubspot",
        "salesforce",
        "zoho"
      ]
    },
    "sync_direction": {
      "type": "string",
      "enum": [
        "to_crm",
        "from_crm"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "default": "success"
    },
    "records_synced": {
      "type": "number",
      "default": 0
    },
    "records_created": {
      "type": "number",
      "default": 0
    },
    "records_updated": {
      "type": "number",
      "default": 0
    },
    "records_failed": {
      "type": "number",
      "default": 0
    },
    "duration_ms": {
      "type": "number"
    },
    "error_details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "connection_id",
    "crm_type",
    "sync_direction"
  ]
}